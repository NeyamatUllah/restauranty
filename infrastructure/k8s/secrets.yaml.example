# TEMPLATE ONLY — never commit real values to git
# To encode a value: echo -n "your-value" | base64
# To apply:         cp secrets.yaml.example secrets.yaml
#                   fill in real base64 values, then:
#                   kubectl apply -f secrets.yaml
#                   (secrets.yaml is in .gitignore)

apiVersion: v1
kind: Secret
metadata:
  name: restauranty-secrets
type: Opaque
data:
  MONGODB_URI: <base64-encoded-mongodb-uri>
  SECRET: <base64-encoded-jwt-secret>
  ORIGIN: <base64-encoded-origin-url>
  CLOUD_NAME: <base64-encoded-cloudinary-cloud-name>
  CLOUD_API_KEY: <base64-encoded-cloudinary-api-key>
  CLOUD_API_SECRET: <base64-encoded-cloudinary-api-secret>
